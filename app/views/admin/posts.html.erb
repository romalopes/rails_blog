<div class="container">
  <h1 class="text-center">Administrator</h1>
  <%= render 'admin/nav_links' %>
  <table class="table table-dark table-striped">
    <thead>
      <tr>
        <td scope="col">Id</td>
        <td scope="col">Post</td>
        <td scope="col">Author</td>
        <td scope="col">Comments</td>
      </tr>
    </thead>
    <tbody>
      <% @post.each do |post| %>
        <tr>
          <td><%= post.id %> </td>
          <td><%= link_to post.title.truncate(15), admin_post_path(post.id) %> </td>
          <td><%= post.user.name %> </td>
          <td><%= pluralize(post.comments.size, "comment") %> </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

